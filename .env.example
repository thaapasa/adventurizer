# Which backend writes the pages: claude-code (uses the logged-in claude CLI)
# or api (uses ANTHROPIC_API_KEY).
STORY_BACKEND=claude-code

# Needed only for the api backend.
ANTHROPIC_API_KEY=

CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Where the books are stored.
BOOKS_DIR=books

# Set to true to save the data of every call to Claude in the trace folder of
# the book: the prompt as Markdown, the request and the response.
TRACE=false
